{
  "name": "datecs-wp25-currency-rates",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src vite.config.ts vitest.config.ts tsconfig.json package.json index.html",
    "format": "biome format --write src vite.config.ts vitest.config.ts tsconfig.json package.json index.html",
    "dupes": "jscpd src --config .jscpd.json",
    "check": "npm run typecheck && npm run lint && npm run dupes && npm test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jscpd": "^5.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
